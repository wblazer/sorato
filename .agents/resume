#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_bin="$(command -v nix 2>/dev/null || true)"

if [[ -z "$nix_bin" && -x "$HOME/.nix-profile/bin/nix" ]]; then
  nix_bin="$HOME/.nix-profile/bin/nix"
fi

test -n "$nix_bin"
test -x "$repo_root/packages/web/node_modules/.bin/vite"

echo "[resume] Nix and workspace dependencies are ready"
