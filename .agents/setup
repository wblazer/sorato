#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile="$HOME/.nix-profile"

as_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

echo "[setup] Ensuring Nix is available"
if ! command -v nix >/dev/null 2>&1 && [[ ! -x "$nix_profile/bin/nix" ]]; then
  command -v curl >/dev/null 2>&1 || {
    as_root apt-get update
    as_root apt-get install -y curl xz-utils
  }
  curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon --yes
fi

for profile_script in \
  "$nix_profile/etc/profile.d/nix.sh" \
  "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"; do
  if [[ -f "$profile_script" ]]; then
    # shellcheck disable=SC1090
    source "$profile_script"
    break
  fi
done

nix_bin="$(command -v nix 2>/dev/null || true)"
if [[ -z "$nix_bin" ]]; then
  echo "[setup] Nix installation did not expose a nix executable" >&2
  exit 1
fi

profile_marker="# Sorato Nix development shell"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

# Sorato Nix development shell
if [[ -z "\${IN_NIX_SHELL:-}" && "\${PWD}" == "$repo_root" ]]; then
  eval "\$("$nix_bin" --extra-experimental-features 'nix-command flakes' print-dev-env "$repo_root")"
fi
EOF
fi

echo "[setup] Installing workspace dependencies"
"$nix_bin" --extra-experimental-features 'nix-command flakes' \
  develop "$repo_root" --command bun install --frozen-lockfile

echo "[setup] Complete"
